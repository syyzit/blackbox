{
  "$comment": "Copy to ~/.blackbox/policy.json. First matching rule wins. Start with mode=shadow; switch to enforce when the log looks right.",
  "default": "allow",
  "mode": "shadow",
  "rugPullBlock": true,
  "rules": [
    {
      "server": "*filesystem*",
      "tool": "write_*",
      "action": "require_approval",
      "reason": "writes change your files"
    },
    {
      "tool": "*",
      "paths": {"path": "/etc/*"},
      "action": "deny",
      "reason": "system paths are off limits"
    },
    {
      "tool": "*",
      "paths": {"*": "*/.ssh/*"},
      "action": "deny",
      "reason": "no SSH keys"
    },
    {
      "tool": "run_command",
      "match": {"command": "git", "args.0": "push"},
      "action": "require_approval",
      "reason": "pushing publishes work"
    },
    {
      "server": "*",
      "tool": "shell",
      "action": "deny",
      "reason": "no shell access"
    }
  ]
}
